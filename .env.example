GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
QDRANT_URL=https://<your-cluster>.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=shopsense_policies
JWT_SECRET=replace-with-at-least-32-random-characters
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
USER_JWT=
# Optional: get an API key from https://console.supermemory.ai to enable
# shopper-scoped cross-session memory.
SUPERMEMORY_API_KEY=
# Optional Langfuse EU tracing. Get both keys from https://cloud.langfuse.com.
# Set both keys to enable tracing; leave both blank to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LOG_LEVEL=INFO
